rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Secure project access - require authentication
    match /projects/{projectId} {
      // Require authentication to read project documents
      allow read: if request.auth != null;

      // Require authentication and ownership to write/modify projects
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
    
    // Default rule - deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}